# Plantilla: la imagen oficial de nginx sustituye ${CONSOLA_API_KEY} y ${API_UPSTREAM} al arrancar
# (solo variables definidas en el entorno; $uri y demas variables de nginx quedan intactas).
server {
  listen 80;
  server_name _;
  absolute_redirect off;
  root /usr/share/nginx/html;

  location = / { return 302 /client/; }
  location = /client { return 301 /client/; }

  # La consola llama a /client/api/...; aqui se agrega la API key, que nunca llega al navegador.
  # DNS de Docker con variable: el nombre se resuelve en cada peticion, asi un backend recreado
  # (IP nueva) no deja a nginx apuntando a la vieja.
  resolver 127.0.0.11 valid=10s ipv6=off;

  location /client/api/ {
    client_max_body_size 21m;
    set $api_upstream ${API_UPSTREAM};
    rewrite ^/client/api/(.*)$ /$1 break;
    proxy_pass $api_upstream;
    proxy_set_header Host $host;
    proxy_set_header x-api-key "${CONSOLA_API_KEY}";
    proxy_set_header Authorization "";
    proxy_read_timeout 120s;
  }

  location /client/assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location /client/ {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /client/index.html;
  }
}
