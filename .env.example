# Copie este archivo a .env y cambie la clave.
# La clave va dentro de DB_CONNECTION_STRING (docker-compose.yml) sin codificar:
# use solo letras, digitos, '-', '_' y '.' (nada de @ : / ? # % ni espacios).
POSTGRES_PASSWORD=cambie-esta-clave

# Claves validas para el header x-api-key, separadas por coma. Vacio = usa la clave
# por defecto del codigo (publica en el repo): en produccion defina siempre una propia.
API_KEYS=

# Clave que usa la consola web (/client) para llamar a la API. Debe estar tambien en API_KEYS.
# El navegador nunca la ve: la agrega el nginx de la consola.
CONSOLA_API_KEY=
